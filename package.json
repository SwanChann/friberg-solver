  "version": "0.1.0",
  "description": "A local-first csgofriberg CS Major player filtering and feedback solver.",
  "license": "MIT",
  "author": "SwanChann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwanChann/friberg-solver.git"
  },
  "homepage": "https://github.com/SwanChann/friberg-solver#readme",
